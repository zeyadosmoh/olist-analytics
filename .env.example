# Copy to .env and fill in your own values. Never commit .env.

# Postgres admin user (used by docker compose, load_raw.sh and dbt)
PG_USER=olist_admin
PG_PASSWORD=change-me

# Optional: dbt connection overrides (defaults shown)
# PG_HOST=localhost
# PG_PORT=5433

# Password for the read-only "metabase_ro" Postgres user (scripts/create_metabase_ro.sh)
MB_DB_PASSWORD=change-me-too

# Metabase admin API key (Admin settings > Authentication > API keys)
MB_API_KEY=
# MB_URL=http://localhost:3000
